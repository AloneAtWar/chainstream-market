# Copy to deploy/.env and set your node. It must answer eth_call by block
# hash near the head (holder-indexer) and serve the Chainlink proxies.
ETH_RPC_URL=http://host.docker.internal:8545
# Block chainstream-evm starts after on its first run; -1 is the chain tip.
ETH_START_HEIGHT=-1
# eth_calls per JSON-RPC batch, each packing up to 100 calls through
# multicall. 10 stays under publicnode's ~1 MB request body; drpc's free tier
# takes at most 3.
ETH_CALL_BATCH_SIZE=10
